# Variaveis de PRODUCAO — referencia para o painel do Railway.
#
# Este arquivo nao e lido por nada: o compose usa `.env`, e em producao quem
# entrega as variaveis e a plataforma. Ele existe para que a lista do que
# precisa ser definido nao viva so na cabeca de quem fez o primeiro deploy.
#
# NUNCA comite valores reais aqui. Os segredos ficam no painel, e o
# `.railway/railway.ts` usa `preserve()` justamente para nao sobrescreve-los.

# --- Obrigatorias: sem elas o servico NAO SOBE ---
# prod.py levanta ImproperlyConfigured no boot, de proposito. Falhar ao subir e
# mais barato do que descobrir a falta em producao.

DJANGO_SETTINGS_MODULE=config.settings.prod

# Gere uma nova, longa e aleatoria. Trocar depois invalida toda sessao ativa.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Origem EXATA do frontend, com esquema. Com SameSite=None e o front em outro
# registrable domain, vazio significa SPA em branco — e a "correcao" tentadora
# (CORS_ALLOW_ALL_ORIGINS com credenciais) e grave.
CORS_ALLOWED_ORIGINS=https://frontend-xxxx.up.railway.app
CSRF_TRUSTED_ORIGINS=https://frontend-xxxx.up.railway.app

# So no servico web. As tres variaveis acima configuram a superficie HTTP, e
# quem as valida e o carregamento do WSGI (config/validacao.py) — worker e cron
# nao passam por la.
#
# No servico web ela e opcional: o dominio do Railway entra sozinho via
# RAILWAY_PUBLIC_DOMAIN (base.py). Declare para dominio proprio.
# DJANGO_ALLOWED_HOSTS=web-xxxx.up.railway.app

# --- Injetadas pela plataforma: referencie, nao digite ---
# DATABASE_URL       -> do servico Postgres
# REDIS_URL          -> do servico Redis
# PORT               -> a porta que o gunicorn deve escutar
# RAILWAY_PUBLIC_DOMAIN -> entra em ALLOWED_HOSTS sozinho (ver base.py)

# Cache do throttle. Banco 1: o 0 e do Celery. Precisa ser compartilhado entre
# os workers, senao cada um tem o SEU contador e o teto vale 3x.
CACHE_URL=redis://default:SENHA@HOST:PORTA/1

# --- Opcionais: tem default no codigo ---

# ALLOWED_HOSTS extra, alem do dominio do Railway (que entra sozinho no servico
# que o tem). So necessario com dominio proprio.
# DJANGO_ALLOWED_HOSTS=api.exemplo.com,web-xxxx.up.railway.app

# Cookie de refresh. O default de prod.py e "None", exigido pela topologia de
# dominios decidida na Phase 0 (*.up.railway.app sao registrable domains
# diferentes). Com dominio proprio de mesmo pai, "Lax" volta a servir.
# AUTH_COOKIE_SAMESITE=None

# Numero de proxies na frente da aplicacao. Default de prod.py: 1. Sem um numero
# declarado, o limite anonimo e contornavel mandando um X-Forwarded-For
# diferente a cada requisicao.
# NUM_PROXIES=1

# Limite de taxa.
# THROTTLE_USER=1000/hour
# THROTTLE_ANON=60/hour
# THROTTLE_EXPORT=20/hour

# Superficies fora da API. DESLIGADAS por default em producao: o schema OpenAPI
# e a planta da API, e publica-lo e escolha, nao consequencia de subir.
# EXPOSE_ADMIN=False
# EXPOSE_API_DOCS=False

# --- Frontend (servico separado) ---
# Embutida no bundle em tempo de BUILD. A imagem do frontend e especifica do
# ambiente: nao existe promover a mesma imagem de staging para producao.
# VITE_API_URL=https://web-xxxx.up.railway.app/api
# RAILWAY_DOCKERFILE_PATH=frontend/Dockerfile

# --- E-mail (Phase 5) ---
# ⚠️ Em producao o default do EMAIL_BACKEND ja e SMTP (prod.py). Sem a senha
# abaixo, todo envio falha — o alerta conta a tentativa e acaba em FAILED.
# Isso e melhor que a alternativa: com o backend de console, o envio
# "funcionaria", os alertas virariam SENT e ninguem receberia nada.
#
# A IMPLANTACAO ATUAL USA SMTP DO GMAIL, e nao um provedor transacional.
#
# A Phase 0 escolheu Resend, e a escolha caiu na hora de implantar por um
# motivo concreto: provedor transacional exige DOMINIO PROPRIO verificado com
# SPF/DKIM, e nao ha dominio proprio neste projeto (a Phase 0 tambem decidiu
# ficar so em *.up.railway.app). Sem dominio, o Resend so entrega no endereco
# do dono da conta — inutil para usuarios reais.
#
# Uma conta de e-mail comum resolve: e um servidor SMTP legitimo, entrega para
# qualquer destinatario e nao pede dominio. O codigo nao mudou nada — ele fala
# SMTP puro desde o inicio, e a amarracao a fornecedor e so a credencial.
#
# Custo da escolha, para quando houver usuarios de verdade: limite de ~500
# e-mails/dia, remetente pessoal em vez do produto, e a reputacao de envio do
# sistema misturada com a da caixa pessoal de quem o opera.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=voce@gmail.com
# No Gmail exige verificacao em duas etapas ligada e uma SENHA DE APP de 16
# caracteres — a senha normal da conta NAO funciona.
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=voce@gmail.com

# Para migrar a um provedor transacional depois (dominio proprio verificado):
#   EMAIL_HOST=smtp.resend.com
#   EMAIL_HOST_USER=resend          # a string literal, nao um endereco
#   EMAIL_HOST_PASSWORD=<API key>
#   DEFAULT_FROM_EMAIL=alertas@seudominio.com

# Os servicos que ENVIAM sao o worker e o cron. O `web` nao envia nada hoje —
# passa a enviar na Phase 10 (recuperacao de senha).
