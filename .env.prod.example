# Variaveis de PRODUCAO — referencia para o painel do Railway.
#
# Este arquivo nao e lido por nada: o compose usa `.env`, e em producao quem
# entrega as variaveis e a plataforma. Ele existe para que a lista do que
# precisa ser definido nao viva so na cabeca de quem fez o primeiro deploy.
#
# NUNCA comite valores reais aqui. Os segredos ficam no painel, e o
# `.railway/railway.ts` usa `preserve()` justamente para nao sobrescreve-los.

# --- Obrigatorias: sem elas o servico NAO SOBE ---
# prod.py levanta ImproperlyConfigured no boot, de proposito. Falhar ao subir e
# mais barato do que descobrir a falta em producao.

DJANGO_SETTINGS_MODULE=config.settings.prod

# Gere uma nova, longa e aleatoria. Trocar depois invalida toda sessao ativa.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Origem EXATA do frontend, com esquema. Com SameSite=None e o front em outro
# registrable domain, vazio significa SPA em branco — e a "correcao" tentadora
# (CORS_ALLOW_ALL_ORIGINS com credenciais) e grave.
CORS_ALLOWED_ORIGINS=https://frontend-xxxx.up.railway.app
CSRF_TRUSTED_ORIGINS=https://frontend-xxxx.up.railway.app

# So no servico web. As tres variaveis acima configuram a superficie HTTP, e
# quem as valida e o carregamento do WSGI (config/validacao.py) — worker e cron
# nao passam por la.
#
# No servico web ela e opcional: o dominio do Railway entra sozinho via
# RAILWAY_PUBLIC_DOMAIN (base.py). Declare para dominio proprio.
# DJANGO_ALLOWED_HOSTS=web-xxxx.up.railway.app

# --- Injetadas pela plataforma: referencie, nao digite ---
# DATABASE_URL       -> do servico Postgres
# REDIS_URL          -> do servico Redis
# PORT               -> a porta que o gunicorn deve escutar
# RAILWAY_PUBLIC_DOMAIN -> entra em ALLOWED_HOSTS sozinho (ver base.py)

# Cache do throttle. Banco 1: o 0 e do Celery. Precisa ser compartilhado entre
# os workers, senao cada um tem o SEU contador e o teto vale 3x.
CACHE_URL=redis://default:SENHA@HOST:PORTA/1

# --- Opcionais: tem default no codigo ---

# ALLOWED_HOSTS extra, alem do dominio do Railway (que entra sozinho no servico
# que o tem). So necessario com dominio proprio.
# DJANGO_ALLOWED_HOSTS=api.exemplo.com,web-xxxx.up.railway.app

# Cookie de refresh. O default de prod.py e "None", exigido pela topologia de
# dominios decidida na Phase 0 (*.up.railway.app sao registrable domains
# diferentes). Com dominio proprio de mesmo pai, "Lax" volta a servir.
# AUTH_COOKIE_SAMESITE=None

# Numero de proxies na frente da aplicacao. Default de prod.py: 1. Sem um numero
# declarado, o limite anonimo e contornavel mandando um X-Forwarded-For
# diferente a cada requisicao.
# NUM_PROXIES=1

# Limite de taxa.
# THROTTLE_USER=1000/hour
# THROTTLE_ANON=60/hour
# THROTTLE_EXPORT=20/hour

# Superficies fora da API. DESLIGADAS por default em producao: o schema OpenAPI
# e a planta da API, e publica-lo e escolha, nao consequencia de subir.
# EXPOSE_ADMIN=False
# EXPOSE_API_DOCS=False

# --- Frontend (servico separado) ---
# Embutida no bundle em tempo de BUILD. A imagem do frontend e especifica do
# ambiente: nao existe promover a mesma imagem de staging para producao.
# VITE_API_URL=https://web-xxxx.up.railway.app/api
# RAILWAY_DOCKERFILE_PATH=frontend/Dockerfile

# --- E-mail (Phase 5, revisado apos Phase 10) ---
# ⚠️ Em producao o default do EMAIL_BACKEND e o do Anymail/Brevo (prod.py).
# Sem a chave abaixo, todo envio falha — o alerta conta a tentativa e acaba em
# FAILED, e o reset de senha loga a falha sem quebrar a resposta (RS-oraculo
# de cadastro). Isso e melhor que a alternativa: com o backend de console, o
# envio "funcionaria" e ninguem receberia nada.
#
# SMTP (Gmail ou qualquer outro provedor) NAO FUNCIONA MAIS aqui — nao e
# credencial errada, e bloqueio de rede: a Railway derruba toda porta SMTP na
# saida (25, 465, 587, 2525), confirmado testando conexao TCP direto de
# dentro do container `web`. So HTTP(S) atravessa o egress, entao o
# transporte teve que virar uma API HTTP.
#
# Por que Brevo e nao Resend/Mailgun/SendGrid: os dois primeiros, sem dominio
# proprio verificado, so entregam para o dono da conta — inutil para reset de
# senha de usuario real (a Phase 0 decidiu ficar so em *.up.railway.app, sem
# dominio proprio). O Brevo verifica so o REMETENTE (sem exigir dominio) e
# entrega para qualquer destinatario. O SendGrid saiu de cogitacao porque o
# django-anymail parou de testar contra a API dele.
#
# ⚠️ Risco aceito conscientemente: o remetente abaixo e um Gmail pessoal, e o
# SPF de gmail.com so autoriza servidor do proprio Google — o Brevo nunca vai
# alinhar. Na pratica, risco real de cair em spam (especialmente em caixa
# Gmail). Um dominio proprio verificado resolveria isso de vez, mas foi
# escolha deliberada nao comprar um agora. Prove o transporte de verdade com
# `python manage.py send_test_email seu@email.com` depois de configurar.
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=voce@gmail.com

# SMTP fica nas settings (base.py) sem uso em producao — so serve quem quiser
# testar contra algo como Mailhog localmente, apontando EMAIL_BACKEND para o
# backend SMTP explicitamente.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=voce@gmail.com
# EMAIL_HOST_PASSWORD=

# Os servicos que ENVIAM sao o worker, o cron E o `web` (recuperacao de senha,
# Phase 10, manda o e-mail dentro da propria requisicao).

# --- rastreamento de erro (Phase 9) -----------------------------------
#
# Vazio = desligado. Com DSN, `prod.py` inicializa o SDK com PII desligado e
# corpo de requisicao NUNCA coletado — as invariantes estao em
# `core/observabilidade.py` e sob teste em
# `tests/security/test_observability_redaction.py`.
#
# O motivo de tanto cuidado: o padrao de fabrica de qualquer APM captura corpo,
# cabecalhos e as variaveis locais de cada frame do traceback. Um IntegrityError
# em `records` leva o `data` inteiro do registro nas locais — colunas
# is_sensitive incluidas. Ligar o SDK com a configuracao padrao desfaz o RS05
# num comando.
SENTRY_DSN=

# Rotulo do ambiente no painel. Sem isto, cai no RAILWAY_ENVIRONMENT_NAME que a
# plataforma injeta; sem os dois, "producao".
# SENTRY_ENVIRONMENT=producao

# Tracing de performance. 0.0 = nenhuma transacao coletada, que e o default.
# Ao ligar, lembre que transacoes carregam a mesma estrutura de contexto que os
# erros — o `before_send_transaction` ja esta ligado no mesmo scrub.
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Os tres servicos que carregam `prod.py` inicializam o SDK: web, worker e
# cron-alertas. Erro de worker e o que mais interessa aqui — ninguem esta
# olhando quando ele quebra.

# --- recuperacao de senha (Phase 10) -----------------------------------
#
# ⚠️ OBRIGATORIA em producao. O link do e-mail aponta para a SPA, e o default
# (`http://localhost:3000`) produziria links que nao levam a lugar nenhum — sem
# erro no envio, sem erro no log, so um usuario que clica e nao chega.
#
# Sem barra no final; o codigo ja normaliza, mas o valor fica mais legivel.
FRONTEND_URL=https://front-xxxx.up.railway.app

# Validade do link, em segundos. Uma hora e o padrao: tempo de sobra para quem
# abre o e-mail no celular, curto o bastante para um link vazado em caixa
# comprometida nao valer por dias.
# PASSWORD_RESET_TIMEOUT=3600

# Teto por IP dos dois endpoints. Cada chamada faz o servidor mandar e-mail para
# um endereco que QUEM CHAMA escolhe — sem teto, e relay de spam contra caixa de
# terceiro, e a reputacao de envio que queima e a do remetente configurado
# acima.
# THROTTLE_PASSWORD_RESET=5/hour

# O `web` manda o e-mail dentro da propria requisicao (ver nota de EMAIL acima
# sobre quem envia). Confira que o servico `web` tem BREVO_API_KEY e
# DEFAULT_FROM_EMAIL — ate esta phase ele nao precisava delas.

# ============================================================================
# --- VPS Hostinger (docker-compose.prod.yml) — alternativa ao Railway ---
# ============================================================================
#
# Bloco DELIBERADAMENTE no fim do arquivo: os nomes abaixo (DJANGO_ALLOWED_HOSTS,
# CORS_ALLOWED_ORIGINS, CSRF_TRUSTED_ORIGINS, FRONTEND_URL) ja apareceram acima
# com valor de Railway.
#
# ⚠️ Diferente do topo do arquivo ("este arquivo nao e lido por nada" — verdade
# so para o Railway, que injeta variaveis pelo painel): para VPS/EasyPanel este
# arquivo VIRA `.env` de verdade (nome fixo — o Compose so le esse nome por
# default, e e onde o EasyPanel escreve o que for configurado no painel dele).
# `docker-compose.prod.yml` LE esse arquivo. Por isso quem monta um `.env` real
# DEVE escolher um dos dois blocos — nao copiar o arquivo inteiro e concatenar
# os dois, senao a ultima ocorrencia de cada variavel e a que vale
# (python-decouple le o arquivo em ordem e a atribuicao mais tardia sobrescreve
# a anterior).
#
# As variaveis que NAO aparecem aqui (BREVO_API_KEY, THROTTLE_*, EXPOSE_*,
# PASSWORD_RESET_TIMEOUT, SENTRY_DSN...) continuam valendo como estao acima —
# nao sao especificas de plataforma.
#
# O que muda e a topologia de dominio. Revisado em 2026-09-16 para quem
# implanta via EasyPanel (servico Compose): o painel roteia cada DOMINIO
# INTEIRO para um servico interno — nao tem roteamento por path dentro do
# mesmo dominio. Entao, em vez de um so dominio com Nginx fazendo /api/ vs /
# (o Nginx de borda manual em docker/nginx/app.conf, para quem NAO usa
# EasyPanel), sao DOIS subdominios, cada um configurado no painel:
#
#   api.exemplo.com -> servico `web`,      porta 8000
#   app.exemplo.com -> servico `frontend`, porta 80
#
# Ver o plano em .claude/plans/remind-task-vps-hostinger-2026-09-16.md
# (Decisao 1 revisada / secao "Pivo: EasyPanel").

DJANGO_ALLOWED_HOSTS=api.exemplo.com

# Mesmo REGISTRABLE DOMAIN nos dois subdominios (api. e app.), entao
# SameSite=Lax continua funcionando — nao e o caso "dois dominios diferentes"
# que obrigou o Railway a usar "None". O default "None" do prod.py existe so
# por causa daquela topologia.
AUTH_COOKIE_SAMESITE=Lax

# ⚠️ Obrigatoria mesmo com os dois subdominios sob controle: `config/validacao.py`
# recusa o boot com a lista vazia, sem excecao. Aqui o CORS e REAL (nao inerte
# como seria em same-origin de um dominio so): o browser da SPA em app.exemplo.com
# manda `Origin: https://app.exemplo.com` ao chamar api.exemplo.com, e sem essa
# origem na lista a chamada e bloqueada.
CORS_ALLOWED_ORIGINS=https://app.exemplo.com
CSRF_TRUSTED_ORIGINS=https://app.exemplo.com

# Self-hosted na propria VPS (servico `db` do docker-compose.prod.yml). So a
# senha e obrigatoria — nome do banco e do usuario tem default "remind" no
# proprio compose (mesmo padrao do compose de desenvolvimento), replicado para
# o container do `web` via `environment:` no arquivo, nao so via env_file.
# POSTGRES_DB=remind
# POSTGRES_USER=remind
POSTGRES_PASSWORD=

# Redis tambem self-hosted (servico `redis`). Sem CACHE_URL/REDIS_URL
# declarados, base.py usa os hosts `db`/`redis` do compose por default — o
# mesmo padrao do compose de desenvolvimento.
# CACHE_URL=redis://redis:6379/1

# So no build do `frontend` (ARG, nao ENV — ver frontend/Dockerfile e
# docker-compose.prod.yml). Subdominio do backend, nao do frontend.
VITE_API_URL=https://api.exemplo.com/api

# O link de recuperacao de senha aponta pra aqui — o subdominio do FRONTEND,
# que e quem renderiza o formulario de nova senha (nao a API).
FRONTEND_URL=https://app.exemplo.com

# Bind do gunicorn. O default `[::]` (docker/entrypoint.sh) cobre a maioria
# dos hosts Linux; declare 0.0.0.0 so se a VPS tiver IPv6 desabilitado.
# GUNICORN_BIND=0.0.0.0
PORT=8000

# Sem RAILWAY_ENVIRONMENT_NAME para cair como fallback — literal.
SENTRY_ENVIRONMENT=producao-vps
