# Copie para .env antes de subir a stack:  cp .env.example .env

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# --- Postgres ---
POSTGRES_DB=remind
POSTGRES_USER=remind
POSTGRES_PASSWORD=remind
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- CORS (frontend futuro) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Limite de taxa ---
# Todas com default no codigo; declaradas aqui para ficarem visiveis.
# O cache guarda os contadores: com LocMemCache cada worker teria o seu, entao
# vai para o Redis (banco 1, separado do 0 que o Celery usa).
# CACHE_URL=redis://redis:6379/1
# THROTTLE_USER=1000/hour
# THROTTLE_ANON=60/hour
# THROTTLE_EXPORT=20/hour

# Numero de proxies na frente da aplicacao. Sem isto, o limite anonimo e
# contornavel mandando um X-Forwarded-For diferente a cada requisicao.
# Em producao, atras do proxy da plataforma, e 1 (default de prod.py).
# NUM_PROXIES=

# --- Superficies fora da API ---
# Ligadas em desenvolvimento, DESLIGADAS em producao por default.
# EXPOSE_ADMIN=True
# EXPOSE_API_DOCS=True

# --- E-mail (RF12, Phase 5) ---
# Em desenvolvimento o default e o backend de CONSOLE: o e-mail aparece no
# terminal e nada e enviado. Nao precisa de credencial nenhuma para trabalhar.
#
# Para exercitar o caminho real, preencha as de baixo. Nada aqui e especifico
# de fornecedor: a aplicacao fala SMTP puro, e trocar de provedor e trocar
# host, porta, usuario e senha.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- Dois caminhos, com consequencias diferentes ---
#
# 1) CONTA DE E-MAIL QUE VOCE JA TEM (Gmail, Outlook). Nao exige dominio
#    proprio e entrega para qualquer destinatario. E o que a implantacao usa
#    hoje. No Gmail exige verificacao em duas etapas ligada e uma SENHA DE APP
#    (16 caracteres) — a senha normal da conta nao funciona. Limite ~500/dia,
#    e os avisos saem do seu endereco pessoal.
#
#      EMAIL_HOST=smtp.gmail.com
#      EMAIL_HOST_USER=voce@gmail.com
#      EMAIL_HOST_PASSWORD=<senha de app, 16 caracteres>
#      DEFAULT_FROM_EMAIL=voce@gmail.com
#
# 2) PROVEDOR TRANSACIONAL (Resend, Postmark, SES, Mailgun). Exige um DOMINIO
#    PROPRIO verificado com SPF/DKIM; sem isso o envio e recusado ou cai em
#    spam. Em troca, o remetente e do produto e a reputacao de envio nao se
#    mistura com a da sua caixa pessoal. No Resend o usuario e a string
#    literal "resend" e a senha e a API key.
#
#      EMAIL_HOST=smtp.resend.com
#      EMAIL_HOST_USER=resend
#      EMAIL_HOST_PASSWORD=<API key>
#      DEFAULT_FROM_EMAIL=alertas@seudominio.com
#
# DEFAULT_FROM_EMAIL precisa ser um endereco que o provedor aceite enviar em
# seu nome. Qualquer outro e recusado no ENVIO, nao na configuracao — o servico
# sobe normalmente e so os e-mails falham.
# DEFAULT_FROM_EMAIL=

# Quanto o envio espera antes de desistir. Sem isto, um SMTP que aceita a
# conexao e nao responde prenderia o worker pelo timeout do sistema (2+ min).
# EMAIL_TIMEOUT=10

# Tentativas antes de marcar o alerta como FAILED, e a base do backoff
# exponencial em minutos (2, 4, 8, 16...).
# EMAIL_MAX_ATTEMPTS=5
# EMAIL_RETRY_BASE_MINUTES=2

# --- rastreamento de erro (Phase 9) -----------------------------------
#
# Vazio = desligado, e e assim que desenvolvimento e CI rodam. Um SDK de APM
# ligado por acidente aqui manda dado de verdade para um projeto de mentira.
# SENTRY_DSN=

# --- recuperacao de senha (Phase 10) -----------------------------------
#
# Para onde o link do e-mail aponta. E a SPA que renderiza o formulario de nova
# senha, nao a API. O default e o Vite local.
# FRONTEND_URL=http://localhost:3000

# Validade do link, em segundos (1 hora). O token carrega o instante de emissao
# e o Django compara na hora de conferir — nao ha registro em banco.
# PASSWORD_RESET_TIMEOUT=3600

# Teto por IP dos dois endpoints do fluxo. Apertado de proposito: cada chamada
# faz o servidor mandar e-mail para um endereco que quem chama escolhe.
# THROTTLE_PASSWORD_RESET=5/hour
