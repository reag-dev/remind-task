# Copie para .env antes de subir a stack:  cp .env.example .env

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# --- Postgres ---
POSTGRES_DB=remind
POSTGRES_USER=remind
POSTGRES_PASSWORD=remind
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- CORS (frontend futuro) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Limite de taxa ---
# Todas com default no codigo; declaradas aqui para ficarem visiveis.
# O cache guarda os contadores: com LocMemCache cada worker teria o seu, entao
# vai para o Redis (banco 1, separado do 0 que o Celery usa).
# CACHE_URL=redis://redis:6379/1
# THROTTLE_USER=1000/hour
# THROTTLE_ANON=60/hour
# THROTTLE_EXPORT=20/hour

# Numero de proxies na frente da aplicacao. Sem isto, o limite anonimo e
# contornavel mandando um X-Forwarded-For diferente a cada requisicao.
# Em producao, atras do proxy da plataforma, e 1 (default de prod.py).
# NUM_PROXIES=

# --- Superficies fora da API ---
# Ligadas em desenvolvimento, DESLIGADAS em producao por default.
# EXPOSE_ADMIN=True
# EXPOSE_API_DOCS=True
